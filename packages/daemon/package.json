{
  "name": "@bytebreak/daemon",
  "version": "0.1.0",
  "description": "ByteBreak background daemon — low CPU event monitor + game host",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bytebreak-daemon": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bytebreak/shared": "workspace:*",
    "@bytebreak/plugin-sdk": "workspace:*",
    "@bytebreak/local-store": "workspace:*",
    "@bytebreak/event-engine": "workspace:*",
    "@bytebreak/game-engine": "workspace:*",
    "@bytebreak/bug-blitz": "workspace:*",
    "@bytebreak/output-rush": "workspace:*",
    "@bytebreak/sql-sprint": "workspace:*",
    "@bytebreak/docker-dash": "workspace:*",
    "@bytebreak/git-arena": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
